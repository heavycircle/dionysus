#ifndef DINO_VERSION_H
#define DINO_VERSION_H

#define DINO_VERSION_MAJOR      @PROJECT_VERSION_MAJOR@
#define DINO_VERSION_MINOR      @PROJECT_VERSION_MINOR@
#define DINO_VERSION_PATCH      @PROJECT_VERSION_PATCH@
#define DINO_VERSION_PRERELEASE "@DINO_VERSION_PRERELEASE@"
#define DINO_VERSION            "@PROJECT_VERSION@@DINO_VERSION_PRERELEASE@"

/* The version as one number, MAJOR * 10000 + MINOR * 100 + PATCH (1.2.3 is
   10203), for #if. A -dev build counts as the version it leads to. */
#define DINO_VERSION_NUMBER \
    (DINO_VERSION_MAJOR * 10000 + DINO_VERSION_MINOR * 100 + DINO_VERSION_PATCH)

/* Whether this SDK is the given version or newer, to use an addition only
   where it exists:
     #if DINO_VERSION_AT_LEAST(1, 1, 0) */
#define DINO_VERSION_AT_LEAST(major, minor, patch) \
    (DINO_VERSION_NUMBER >= (major) * 10000 + (minor) * 100 + (patch))

#endif
