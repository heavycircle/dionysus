# Shared by the SDK and every project `dino init` creates. scripts/tidy.sh adds
# --warnings-as-errors for CI; in editors these stay warnings. The `-*` would
# also hide compiler warnings, so the portability warnings (calls with a dino_*
# replacement, docs/guide/portability-warnings.md) are let back in by name.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -bugprone-easily-swappable-parameters,
  clang-diagnostic-deprecated-declarations
# System headers stay excluded; the SDK headers are clean, so they don't add noise.
HeaderFilterRegex: '.*'
# The list form of CheckOptions, not the shorter map form: clang-tidy and clangd
# 14 (Ubuntu 22.04) can't parse the map form and would ignore this whole file.
CheckOptions:
  # Reserved names code is meant to use: feature-test macros, and the
  # __wrap_/__real_ symbols the linker's --wrap requires (sdk/testing/leakcheck.c).
  - key: bugprone-reserved-identifier.AllowedIdentifiers
    value: '_LARGEFILE64_SOURCE;_FILE_OFFSET_BITS;_GNU_SOURCE;_POSIX_C_SOURCE;_XOPEN_SOURCE;_DEFAULT_SOURCE;^__(wrap|real)_.*$'
