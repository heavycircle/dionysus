# Check for Windows
if(CMAKE_SYSTEM_PLATORM MATCHES "win*")
    set(CMAKE_C_FLAGS "-std=c99 -Wall -Wextra -Wno-format -Wno-attributes -fcommon -ffreestanding -fno-stack-protector")
    set(OS "windows")
    set(TARGET "windows")
    set(CMAKE_SYSTEM_NAME Windows)
    add_definitions(-DWINDOWS)
else()
    set(CMAKE_C_FLAGS "-std=c99 -Wall -Wextra -Wno-misleading-information -fcommon -ffreestanding -fno-stack-protector -fno-zero-initialized-in-bss")
    set(OS "linux")
    set(TARGET "linux")
    set(CMAKE_SYSTEM_NAME Linux)
    add_definitions(-DLINUX)
endif()

# Iterate through architectures
if(CMAKE_SYSTEM_PLATFORM STREQUAL "x86_64")
    message(STATUS "Compiling for x86_64 ...")
    set(ARCH "x86_64")
    set(PLATFORM "x86_64")
elseif(CMAKE_SYSTEM_PLATFORM STREQUAL "x86")
    message(STATUS "Compiling for x86 ...")
    set(ARCH "x86")
    set(PLATFORM "x86")
    set(CMAKE_C_FLAGS "-m32 ${CMAKE_C_FLAGS}")
elseif(CMAKE_SYSTEM_PLATFORM STREQUAL "i386")
    message(STATUS "Compiling for i386 ...")
    set(ARCH "i386")
    set(PLATFORM "i386")
    set(USE_SOCKETCALLS ON)
    set(CMAKE_C_FLAGS "-march=i386 ${CMAKE_C_FLAGS}")
endif()

# Check for socketcalls
if(USE_SOCKETCALLS STREQUAL "ON")
    message(STATUS "Using Socketcalls!")
    add_definitions(-DUSE_SOCKETCALLS)
endif()

# Check build type
if(CMAKE_BUILD_TYPE STREQUAL "release")
    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Os -ffreestanding --ffunction-sections -fdata-sections -Wl,--gc-sections -Wl,-s")

    if(CMAKE_SYSTEM_PLATFORM MATCHES "win*")
        set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -W")
    else()
        set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -s -Wl,--gc-sections -Wl,-z,-norelro -Wl,--build-id=none")
    endif()
elseif(CMAKE_BUILD_TYPE STREQUAL "debug")
    if(CMAKE_SYSTEM_PLATFORM MATCHES "win*")
        set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -O0 -g -W")
    else()
        set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -O0 -g -Wl,-z,-norelro")
    endif()
endif()
