BasedOnStyle: WebKit
AlignConsecutiveAssignments: true
AlignConsecutiveDeclarations: true
AlignConsecutiveMacros: true
AlignTrailingComments: true
AllowShortFunctionsOnASingleLine: None
BreakBeforeBraces: Allman
ColumnLimit: 100
PointerAlignment: Right
# The extern "C" guards in the SDK headers wrap whole files: no extra indent.
IndentExternBlock: NoIndent
# Includes: the file's own header, then system headers, then other dino headers.
IncludeBlocks: Regroup
SortIncludes: CaseSensitive
# SDK only: `dino init` leaves these lines out of the copy it writes, because
# MainIncludeChar needs clang-format 19 and older versions reject the file.
# <dino/core/io.h> is io.c's main header even though it uses angle brackets,
# and also io_posix.c's and io_win32.c's.
MainIncludeChar: Any
# End of SDK only.
IncludeIsMainRegex: '(_posix|_win32)?$'
IncludeCategories:
  # Must precede <windows.h>, which otherwise pulls in the old winsock.h.
  - Regex: '^<(winsock2|ws2tcpip)\.h>$'
    Priority: 2
  - Regex: '^<windows\.h>$'
    Priority: 3
  # Windows headers that need <winsock2.h> or <windows.h> first: after <windows.h>,
  # in its block.
  - Regex: '^<(aclapi|bcrypt|dbghelp|iphlpapi|iptypes|mstcpip|mswsock|ntstatus|psapi|sddl|shellapi|tlhelp32|userenv|wincrypt|winioctl|winternl)\.h>$'
    Priority: 3
    SortPriority: 4
  - Regex: '^<dino/'
    Priority: 5
  - Regex: '^<'
    Priority: 1
